    {
      "parameters": {
        "description": "Validates if all required lead information has been collected and client has confirmed. Returns JSON with validation status.",
        "jsCode": "const leadData = $input.all();\nconst conversationHistory = $input.all();\n\n// Extract lead information from conversation\nlet service = null;\nlet dates = null;\nlet travellers = null;\nlet comments = null;\nlet confirmed = false;\n\n// Check conversation for required fields\nconst conversationText = JSON.stringify(conversationHistory).toLowerCase();\n\n// Simple validation logic\nif (conversationText.includes('service') || conversationText.includes('tour') || conversationText.includes('package')) {\n  service = 'detected';\n}\nif (conversationText.includes('date') || conversationText.includes('when')) {\n  dates = 'detected';\n}\nif (conversationText.includes('traveller') || conversationText.includes('person') || conversationText.includes('people')) {\n  travellers = 'detected';\n}\nif (conversationText.includes('ok') || conversationText.includes('confirm') || conversationText.includes('yes')) {\n  confirmed = true;\n}\n\nconst missing = [];\nif (!service) missing.push('Service Type');\nif (!dates) missing.push('Travel Dates');\nif (!travellers) missing.push('Number of Travellers');\nif (!confirmed) missing.push('Client Confirmation');\n\nconst valid = missing.length === 0;\n\nreturn {\n  json: {\n    valid: valid,\n    missing: missing,\n    lead: {\n      service: service || 'Not provided',\n      dates: dates || 'Not provided',\n      travellers: travellers || 'Not provided',\n      comments: comments || 'None',\n      confirmed: confirmed\n    }\n  }\n};"
      },
      "id": "4045fffb-cad4-4f6a-bd18-2dbb95c75ae4",
      "name": "Think Tool - Validate Lead Data",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        -928,
        544
      ]
    },
    {
      "parameters": {
        "description": "Performs final validation before completing the lead qualification process. Returns confirmation status.",
        "jsCode": "const leadData = $input.all();\n\n// Final check logic\nconst allFieldsPresent = leadData.some(item => \n  item.json && \n  item.json.service && \n  item.json.dates && \n  item.json.travellers\n);\n\nreturn {\n  json: {\n    passed: allFieldsPresent,\n    message: allFieldsPresent ? 'All validations passed' : 'Missing required fields',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "3345c581-4a8d-4e91-a0e5-8b0bcba5ad84",
