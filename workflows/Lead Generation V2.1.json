    {
      "parameters": {
        "jsCode": "const agents = $input.all();\n\nlet assignedAgent = 'Unassigned';\n\nif (agents && agents.length > 0) {\n  // Get current assignment count from workflow state or use round-robin\n  const currentIndex = $execution.customData?.agentIndex || 0;\n  \n  // Assign to next agent in rotation\n  assignedAgent = agents[currentIndex % agents.length].json.Agent;\n  \n  // Update index for next assignment\n  $execution.customData = { agentIndex: (currentIndex + 1) % agents.length };\n} else {\n  assignedAgent = 'Unassigned';\n}\n\nreturn {\n  json: {\n    ...$input.first().json,\n    assignedAgent: assignedAgent,\n    assignedAt: new Date().toISOString()\n  }\n};"
      },
